# Google Tag Manager
#
# Use somente o ID real do container, no formato GTM-XXXXXXX.
# Sem esta variável, nenhum script do Google Tag Manager será carregado.
NEXT_PUBLIC_GTM_ID=

# Lead Capture
#
# URL privada do webhook operacional que receberá leads validados.
LEAD_WEBHOOK_URL=

# Segredo compartilhado entre o ADRIZIO e o receptor do webhook.
# Nunca use prefixo NEXT_PUBLIC_.
LEAD_WEBHOOK_SECRET=
