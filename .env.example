# Google Tag Manager
#
# Use somente o ID real do container, no formato GTM-XXXXXXX.
# Sem esta variável, nenhum script do Google Tag Manager será carregado.
NEXT_PUBLIC_GTM_ID=

# Lead Capture
#
# URL privada do webhook operacional que receberá leads validados.
LEAD_WEBHOOK_URL=

# Segredo compartilhado entre o ADRIZIO e o receptor do webhook.
# Nunca use prefixo NEXT_PUBLIC_.
LEAD_WEBHOOK_SECRET=

# Database
#
# PostgreSQL local de desenvolvimento.
# Nunca coloque a senha real neste arquivo.
DATABASE_URL="postgresql://adrizio_app:CHANGE_ME@127.0.0.1:5432/adrizio_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://adrizio_app:CHANGE_ME@127.0.0.1:5432/adrizio_shadow?schema=public"
